@startuml

class producto {
  codigo
  nombre
  descripcion
  marca
  precio
}

class cliente {
  dpi
  nombre
  direccion
  fechaNacimiento
  tipo
}

class Empleado {
  id
  nombre
  dpi
  direccion
  puesto
  salario
}

class Bodega {
  id
  idEmpleado
  capacidad
  direccion
}

class Inventario {
  idBodega
  codigoProducto
  cantidad
}

class OrdenCompra {
  id
  dpiCliente
  codigoProducto
  cantidad
  fecha
  total
  estado
  idBodega
}

Bodega --> Empleado
Inventario --> Bodega
Inventario --> producto
OrdenCompra --> cliente
OrdenCompra --> producto
OrdenCompra --> Bodega

@enduml
